# Backend Environment Variables
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/marrakech_drive
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=your_super_secret_random_string_here
JWT_ALGORITHM=HS256
